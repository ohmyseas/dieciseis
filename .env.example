# ElevenLabs TTS Configuration
# Optional: Set this to enable server-side API key (more secure)
# If not set, users can enter their own API key via Settings modal
ELEVENLABS_API_KEY=sk-your-elevenlabs-api-key-here

# Vercel KV Database URL
# Auto-configured by Vercel when you connect KV storage
KV_URL=redis://your-kv-url
KV_REST_API_URL=https://your-kv-url.vercel.app
KV_REST_API_TOKEN=your-token
